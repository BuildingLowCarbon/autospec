      "fr": {
        "name": "Paroi extérieure D1233 Montants RE",
        "description": "Paroi extérieure composée d'une construction de base de montants avec isolation de la cavité de la structure support. Contreventement côté extérieur et côté intérieur, contreventement double côté extérieur, contreventement double côté intérieur. Sans parement. façade ventilée."
      },
      "en": {
        "name": "Outer wall D1233 Stud",
        "description": "Outer wall consisting of a basic construction of stud with cavity insulation in the supporting structure. Sheathed outside & interior, on the outside twice sheathed, roomside double sheathed. Without covering. Ventilated facade."
      },
      "de": {
        "name": "Aussenwand D1233 Ständer",
        "description": "Aussenwand mit einer Tragkonstruktion bestehend aus Ständer mit Hohlraumdämmung in der Tragkonstruktion. Beplankung aussen & innen, aussen doppelt beplankt, innen doppelt beplankt. Ohne Bekleidung. Hinterlüftete Fassade."
      }
    },
