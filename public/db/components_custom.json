    "translations": {
      "fr": {
        "name": "Paroi extérieure - Montants - RIAZ",
        "description": "Paroi extérieure composée d'une construction de base de montants avec isolation de la cavité de la structure support. Contreventement côté extérieur et côté intérieur, contreventement double côté extérieur, contreventement simple côté intérieur. Parement simple avec isolation des cavités du parement. façade ventilée."
      },
      "en": {
        "name": "Outer wall D1237 Stud",
        "description": "Outer wall consisting of a basic construction of stud with cavity insulation in the supporting structure. Sheathed outside & interior, on the outside twice sheathed, roomside single sheathed. Simple covering with cavity insulation. Ventilated facade."
      },
      "de": {
        "name": "Aussenwand D1237 Ständer",
        "description": "Aussenwand mit einer Tragkonstruktion bestehend aus Ständer mit Hohlraumdämmung in der Tragkonstruktion. Beplankung aussen & innen, aussen doppelt beplankt, innen einfach beplankt. Einfache Bekleidung mit Hohlraumdämmung in der Bekleidung. Hinterlüftete Fassade."
      }
    },
