{
  "version": "1.0.0",
  "module": "fire_requirements",
  "i18n": {
    "use": {
      "residential": { "fr": "Résidentiel", "en": "Residential", "de": "Wohnen", "it": "Residenziale" }
    },
    "building_type": {
      "single_family": {
        "fr": "Maison individuelle",
        "en": "Single-family",
        "de": "Einfamilienhaus",
        "it": "Monofamiliare"
      },
      "multi_family": {
        "fr": "Habitat collectif",
        "en": "Multi-family",
        "de": "Mehrfamilienhaus",
        "it": "Plurifamiliare"
      }
    },
    "building_height": {
      "lt_11": { "fr": "< 11 m", "en": "< 11 m", "de": "< 11 m", "it": "< 11 m" },
      "btw_11_30": { "fr": "> 11 m et < 30 m", "en": "> 11 m & < 30 m", "de": "> 11 m & < 30 m", "it": "> 11 m e < 30 m" },
      "gt_30": { "fr": "> 30 m", "en": "> 30 m", "de": "> 30 m", "it": "> 30 m" }
    },
    "neighbor_distance": {
      "gt_10": { "fr": "> 10 m", "en": "> 10 m", "de": "> 10 m", "it": "> 10 m" },
      "le_10": { "fr": "≤ 10 m", "en": "≤ 10 m", "de": "≤ 10 m", "it": "≤ 10 m" }
    }
  },

  "dropdowns": {
    "use": ["residential"],
    "building_type": ["single_family", "multi_family"],
    "building_height": {
      "single_family": ["lt_11"],
      "multi_family": ["lt_11", "btw_11_30", "gt_30"]
    },
    "neighbor_façade_distance": ["gt_10", "le_10"]
  },

  "filter_categories": {
    "roof_flat_shed": "flat_roof_shed_roof",
    "roof_steep": "steep_roof",
    "floor": "floor_assembly",
    "partition_double": "partition_wall_double_shell",
    "partition_single": "partition_wall_single_shell",
    "outer_wall": "outer_wall"
  },

  "elements": [
    {
      "id": "roof",
      "label": { "fr": "Toiture", "en": "Roof", "de": "Dach", "it": "Tetto" },
      "targets": [
        { "categoryId": "flat_roof_shed_roof", "label": { "fr": "Toiture plate / à un pan", "en": "Flat / shed roof", "de": "Flachdach / Pultdach", "it": "Tetto piano / a falda unica" } },
        { "categoryId": "steep_roof", "label": { "fr": "Toiture inclinée", "en": "Steep roof", "de": "Steildach", "it": "Tetto inclinato" } }
      ],
      "subtypes": [
        { "id": "generic", "label": { "fr": "", "en": "", "de": "", "it": "" } }
      ]
    },

    {
      "id": "floor",
      "label": { "fr": "Plancher", "en": "Floor assembly", "de": "Decke/Boden", "it": "Solaio" },
      "targets": [{ "categoryId": "floor_assembly", "label": { "fr": "Plancher", "en": "Floor assembly", "de": "Deckenaufbau", "it": "Solaio" } }],
      "subtypes": [
        { "id": "same_unit", "label": { "fr": "(même unité)", "en": "(same unit)", "de": "(gleiche Nutzungseinheit)", "it": "(stessa unità)" } },
        { "id": "between_units", "label": { "fr": "(entre unités)", "en": "(between units)", "de": "(zwischen Nutzungseinheiten)", "it": "(tra unità)" } },
        { "id": "to_unheated_outside", "label": { "fr": "(contre extérieur / non chauffé)", "en": "(against exterior / unheated)", "de": "(gegen außen / unbeheizt)", "it": "(verso esterno / non riscaldato)" } },
        { "id": "to_ground", "label": { "fr": "(contre terre)", "en": "(against ground)", "de": "(gegen Erdreich)", "it": "(contro terra)" } }
      ]
    },

    {
      "id": "partition",
      "label": { "fr": "Paroi intérieure", "en": "Internal partition", "de": "Innenwand", "it": "Parete interna" },
      "targets": [
        { "categoryId": "partition_wall_double_shell", "label": { "fr": "Double coque", "en": "Double shell", "de": "Doppelschalig", "it": "Doppia parete" } },
        { "categoryId": "partition_wall_single_shell", "label": { "fr": "Simple coque", "en": "Single shell", "de": "Einschalig", "it": "Parete semplice" } }
      ],
      "subtypes": [
        { "id": "same_unit", "label": { "fr": "(même unité)", "en": "(same unit)", "de": "(gleiche Nutzungseinheit)", "it": "Stessa unità" } },
        { "id": "between_units", "label": { "fr": "(entre unités)", "en": "(between units)", "de": "(zwischen Nutzungseinheiten)", "it": "(tra unità)" } }
      ],
      "bearing": [
        { "id": "non_bearing", "label": { "fr": "(non-porteur)", "en": "(non load-bearing)", "de": "(nicht tragend)", "it": "(non portante)" } },
        { "id": "bearing", "label": { "fr": "(porteur)", "en": "(load-bearing)", "de": "(tragen)", "it": "(portante)" } }
      ]
    },

    {
      "id": "outer_wall",
      "label": { "fr": "Façade extérieure", "en": "External façade/wall", "de": "Außenwand/Fassade", "it": "Parete/facciata esterna" },
      "targets": [{ "categoryId": "outer_wall", "label": { "fr": "Mur extérieur", "en": "Outer wall", "de": "Außenwand", "it": "Parete esterna" } }],
      "subtypes": [
        { "id": "neighbor_gt_10", "label": { "fr": "(façade voisine > 10 m)", "en": "(neighboring facade > 10 m)", "de": "(benachbarte Fassade > 10 m)", "it": "(facciata adiacente > 10 m)" } },
